{
  "name": "zenith-code",
  "version": "1.0.0",
  "description": "Zenith Code 1.0 — assistente de IA local e de nuvem com agente de código, ferramentas, skills e terminal.",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build:server": "node scripts/build-server.mjs",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-release.ps1",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "cli": "tsx server/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/tests/core.test.ts"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "katex": "0.16.11",
    "marked": "^14.1.2",
    "node-llama-cpp": "3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
